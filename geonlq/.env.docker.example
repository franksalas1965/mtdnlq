# =============================================================================
# GeoNLQ — Despliegue Docker (Variante B) con PostgreSQL/PostGIS en el SERVIDOR
# =============================================================================
# Copiar a .env en la raíz del proyecto en el servidor destino:
#   cp .env.docker.example .env
#   chmod 600 .env
#
# Levantar solo la API (sin contenedor PostGIS):
#   docker compose -f docker-compose.external-db.yml up -d --build
# =============================================================================

# --- Conexión PostgreSQL/PostGIS (vista desde el contenedor GeoNLQ) ---
#
# Postgres en el MISMO servidor Linux que Docker:
#   POSTGRES_HOST=host.docker.internal
#
# Postgres en OTRO host (IP o FQDN; pg_hba.conf y listen_addresses deben permitirlo):
#   POSTGRES_HOST=192.168.1.50
#   POSTGRES_HOST=db.mi-dominio.cu
#
POSTGRES_HOST=host.docker.internal
# En WSL con Postgres en Docker en el host (ej. postgres14-3.3): suele ser 5434, no 5432.
POSTGRES_PORT=5432
POSTGRES_DB=geonlq
POSTGRES_USER=geonlq_reader
POSTGRES_PASSWORD=cambiar_password_seguro

# Opcional: URL completa (si la defines, comenta DATABASE_URL en docker-compose.external-db.yml
# y deja solo env_file, o usa esta línea y elimina el bloque environment del compose).
# Caracteres especiales en la contraseña deben ir URL-encoded (@ → %40, etc.).
# DATABASE_URL=postgresql+psycopg2://geonlq_reader:password@host.docker.internal:5432/geonlq

# --- Puerto HTTP expuesto en el host ---
GEONLQ_HOST_PORT=8000
GEONLQ_IMAGE_TAG=latest
UVICORN_WORKERS=2

# --- Proveedor LLM: openai | anthropic | ollama ---
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5-coder:1.5b

# --- OpenAI ---
# OPENAI_API_KEY=sk-...

# --- Anthropic ---
# ANTHROPIC_API_KEY=sk-ant-...

# --- Ollama en el mismo servidor (desde el contenedor NO uses localhost) ---
OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_TIMEOUT_SECONDS=180

# --- Comportamiento ---
MAX_RESULTS=100
SQL_TIMEOUT=30
SCHEMA_CACHE_TTL=300
MAX_LLM_RETRIES=2
ALLOWED_SCHEMAS=public

# --- CORS (dominios del frontend, separados por coma; no usar * en producción) ---
CORS_ORIGINS=https://mi-app.dominio.cu

# --- Logging ---
# LOG_LEVEL: logging de la app (INFO, DEBUG, …). UVICORN_LOG_LEVEL: solo CLI uvicorn (minúsculas).
LOG_LEVEL=INFO
UVICORN_LOG_LEVEL=info
DEBUG=false
