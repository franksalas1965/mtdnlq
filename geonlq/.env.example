# =============================================================================
# GeoNLQ — Variables de entorno
# Copiar este archivo como .env y completar los valores
# =============================================================================

# --- Base de datos PostGIS ---
DATABASE_URL=postgresql+psycopg2://geonlq_reader:tu_password@localhost:5432/geonlq

# --- Proveedor LLM: openai | anthropic | ollama ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# --- OpenAI (si LLM_PROVIDER=openai) ---
OPENAI_API_KEY=sk-...

# --- Anthropic (si LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Ollama (si LLM_PROVIDER=ollama, servidor local) ---
OLLAMA_BASE_URL=http://localhost:11434
# LLM_MODEL=llama3.1  # o mistral, qwen2.5-coder, etc.

# --- Comportamiento ---
MAX_RESULTS=100
SQL_TIMEOUT=30
SCHEMA_CACHE_TTL=300
MAX_LLM_RETRIES=2
ALLOWED_SCHEMAS=public

# --- Logging ---
LOG_LEVEL=INFO
DEBUG=false
