# =============================================================================
# MTD-NLQ — Variables de entorno (MTD 1:10 000 — base mtd10)
# Copiar este archivo como .env y completar los valores
# =============================================================================

# --- Base de datos PostGIS (MTD escala 1:10 000) ---
#
# PostgreSQL en WINDOWS (pgAdmin, puerto 5433) — MTD-NLQ corriendo en WINDOWS:
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/mtd10
#
# PostgreSQL en WINDOWS — MTD-NLQ corriendo en WSL (venv, sin Docker):
# Usa la IP del host Windows (WSL no ve localhost:5433 de Windows):
#   WIN_IP=$(grep nameserver /etc/resolv.conf | awk '{print $2}')
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@${WIN_IP}:5433/mtd10
#
# Con Docker Compose use .env.docker.example (POSTGRES_HOST=host.docker.internal)

# --- Proveedor LLM: openai | anthropic | ollama ---
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5-coder:1.5b

# --- OpenAI (si LLM_PROVIDER=openai) ---
# OPENAI_API_KEY=sk-...

# --- Anthropic (si LLM_PROVIDER=anthropic) ---
# ANTHROPIC_API_KEY=sk-ant-...

# --- Ollama ---
# Modo: local (CPU/GPU en su red) | cloud (ollama.com, requiere API key)
OLLAMA_MODE=local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CLOUD_BASE_URL=https://ollama.com
# OLLAMA_API_KEY=          # https://ollama.com/settings/keys (obligatorio si OLLAMA_MODE=cloud)
# Dispositivo solo en local: auto | cpu | gpu
OLLAMA_DEVICE=auto
OLLAMA_NUM_GPU=-1
OLLAMA_NUM_THREAD=0
OLLAMA_TIMEOUT_SECONDS=180

# Ejemplo Ollama Cloud (descomente y complete):
# OLLAMA_MODE=cloud
# OLLAMA_API_KEY=su_clave
# LLM_MODEL se asigna solo a gemma4:31b (tier bajo, 256K ctx, buen código/SQL)
# Para máxima calidad SQL: LLM_MODEL=qwen3.5:397b

# Ejemplo servidor local con GPU:
# OLLAMA_MODE=local
# OLLAMA_DEVICE=gpu
# LLM_MODEL=qwen2.5-coder:7b
# Ver docs/CONFIGURACION_LLM.md

# --- Comportamiento ---
MAX_RESULTS=100
SQL_TIMEOUT=120
SCHEMA_CACHE_TTL=300
MAX_LLM_RETRIES=2

# Cola asíncrona — POST /api/v1/query/async + GET /api/v1/jobs/{id}
MAX_CONCURRENT_LLM_JOBS=1
MAX_QUEUED_JOBS=100
JOB_RETENTION_SECONDS=3600

# Escalas atendidas por ESTA instancia (misma URL, distintas BDs mtdN)
# Una sola instancia puede servir a muchos clientes QGIS en paralelo.
MTD_ENABLED_SCALES=10000

# Esquemas temáticos MTD 1:10 000 — prefijo 10_ (= escala 1:10 000)
# Para 1:25 000 usar mtd25 y prefijo 25_; para 1:100 000 usar mtd100 y 100_
# Ver docs/CONVENCION_ESCALAS.md
ALLOWED_SCHEMAS=10_areas_verdes_y_terrenos,10_hidrografia,10_hidrografia_presas,10_limites_estatales,10_objetivos_economicos,10_provincias_y_cercas,10_puntos_de_apoyo,10_puntos_poblados,10_red_vial,10_relieve

# --- CORS ---
CORS_ORIGINS=*

# --- Logging ---
LOG_LEVEL=INFO
DEBUG=false
