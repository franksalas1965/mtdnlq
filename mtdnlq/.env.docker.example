# =============================================================================
# MTD-NLQ — Despliegue Docker con PostgreSQL/PostGIS externo (MTD)
# =============================================================================
# Copiar a .env en la raíz del proyecto:
#   cp .env.docker.example .env
#
# Levantar solo la API (sin contenedor PostGIS):
#   docker compose -f docker-compose.external-db.yml up -d --build
# =============================================================================

# --- Conexión PostgreSQL/PostGIS (vista desde el contenedor Docker en WSL) ---
#
# PostgreSQL instalado en WINDOWS (no en WSL):
#   pgAdmin → localhost:5433, BD mtd10, user postgres
# Desde el contenedor usar host.docker.internal (NO localhost):
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5433
POSTGRES_DB=mtd10
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Puerto HTTP expuesto en el host ---
# Usar 8001 si GeoNLQ ya ocupa el 8000 en la misma máquina
MTDNLQ_HOST_PORT=8001
MTDNLQ_IMAGE_TAG=latest
UVICORN_WORKERS=2

# --- Proveedor LLM: openai | anthropic | ollama ---
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5-coder:1.5b

# --- Ollama en el mismo servidor (desde el contenedor NO uses localhost) ---
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_TIMEOUT_SECONDS=180

# --- Comportamiento ---
MAX_RESULTS=100
SQL_TIMEOUT=30
SCHEMA_CACHE_TTL=300
MAX_LLM_RETRIES=2

# Esquemas temáticos MTD 1:10 000 (138 tablas — ver docs/ESQUEMA_MTD10.md)
ALLOWED_SCHEMAS=10_areas_verdes_y_terrenos,10_hidrografia,10_hidrografia_presas,10_limites_estatales,10_objetivos_economicos,10_provincias_y_cercas,10_puntos_de_apoyo,10_puntos_poblados,10_red_vial,10_relieve

# --- CORS (dominios del frontend web o QGIS Web; separados por coma) ---
CORS_ORIGINS=*

# --- Logging ---
LOG_LEVEL=INFO
UVICORN_LOG_LEVEL=info
DEBUG=false
